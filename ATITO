// بيجمّع كل سبمت كـ record، والفلاتر (Modality/Pass) بتتطبق عليها قبل أي جدول
function computeTeams(tm,db,date,shiftCode){
  const tc=cmap(tm.headers), iP=ci(tc,['pc no.','pc no']), iL=ci(tc,['location']), iQ=ci(tc,['tl/ qtc','tl/qtc','tl / qtc']), iS=ci(tc,['shift']);
  const owners={}, order=[], pcs=[], emailMap={}; let cur=null; const iEm=ci(tc,['labeler yubikey','yubikey','yubikey email']);
  tm.rows.forEach(r=>{
    const raw=String(gc(r,iQ)||'').trim();
    if(raw){ const key=normName(raw); if(key){ cur=key; if(!owners[key]){ owners[key]={raw,shift:shiftFromName(raw)||shiftOrEmpty(gc(r,iS))}; order.push(key); } } }
    const pc=extractPc(gc(r,iP)); if(pc&&cur) pcs.push({key:cur,pc,room:roomKey(gc(r,iL))});
    const em=String(gc(r,iEm)||'').trim().toLowerCase(); if(em.includes('@')&&cur) emailMap[em]=cur;
  });
  let keys=order.filter(k=>owners[k].shift===shiftCode); if(!keys.length) keys=order.slice();
  const allowed={}; keys.forEach(k=>allowed[k]=true);
  const pcMap={}; pcs.forEach(p=>{ if(!allowed[p.key]) return; if(p.room) pcMap[p.room+'_'+p.pc]=p.key; pcMap[p.pc]=p.key; });
  const d=cmap(db.headers), iTs=ci(d,['timestamp']); let iRoom=ci(d,['unit']); if(iRoom<0) iRoom=ci(d,['queue name']);
  const iEmD=ci(d,['yubikey email']);
  const iQtc=ci(d,['qtc name']); if(iQtc<0) throw new Error('Column "QTC Name" not found in Data Base. Columns: '+db.headers.join(' | '));
  const iPc=ci(d,['pc no']), iMod=ci(d,['modality']), iPass=ci(d,['pass']);
  const recs=[], avail={};
  db.rows.forEach(row=>{
    const t=parseTS(gc(row,iTs)); if(!t) return;
    const rawRoom=gc(row,iRoom), cls=shiftOf(rawRoom,t);
    if(cls){ const a=avail[cls.date]=avail[cls.date]||{ON:0,M:0,N:0}; a[cls.shift]++; }
    if(!cls||cls.shift!==shiftCode||cls.date!==date) return;
    const sub=String(gc(row,iQtc)||'').trim(), rawPc=gc(row,iPc);
    const rec={ qc:cleanName(sub), mod:/LANE|LINE/i.test(String(gc(row,iMod)||''))?'Lane':'Lidar', pass:isQAPass(gc(row,iPass))?'QA':'FP', team:null, label:null };
    if(String(rawPc).toUpperCase().includes('BUFFER')||sub.toUpperCase().includes('BUFFER')) rec.label='Buffer';
    else { const sp=specialLabel(rawPc);
      if(sp) rec.label=sp;
      else { const pc=extractPc(rawPc);
        if(!pc) rec.label='No PC';
        else { const ok=pcMap[(roomKey(rawRoom)||'')+'_'+pc]||pcMap[pc]; if(ok) rec.team=ok; else rec.label='Unmatched PC'; } } }
    if(!rec.team&&(rec.label==='No PC'||rec.label==='Unmatched PC')){ const k=emailMap[String(gc(row,iEmD)||'').trim().toLowerCase()]; if(k&&allowed[k]){ rec.team=k; rec.label=null; } }
    recs.push(rec);
  });
  const samples=db.rows.slice(-3).map(r=>{ const t=parseTS(gc(r,iTs)); return String(gc(r,iTs))+' → '+(t?t.date+' / '+t.mins+' min':'غير مقروء'); });
  return { recs, keys, owners, avail, samples, nRows:db.rows.length, tsCol:iTs, shift:shiftCode, date };
}
