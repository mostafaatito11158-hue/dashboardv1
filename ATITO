  return w?s/w:'';
}
const MON=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
function weekParts(w){
  if(w===''||w==null) return null; const s=String(w).trim(); let m,y,mo,d;
  if((m=s.match(/^(\d{4})\D+(\d{1,2})\D+(\d{1,2})/))){ y=+m[1]; mo=+m[2]; d=+m[3]; if(mo>12){ const t=mo; mo=d; d=t; } }
  else { const t=parseTS(s); if(!t) return null; [y,mo,d]=t.date.split('-').map(Number); }
  return (mo>=1&&mo<=12&&d>=1&&d<=31)?[y,mo,d]:null;
}
function weekKey(w){ const p=weekParts(w); return p?p[0]+'-'+pad(p[1])+'-'+pad(p[2]):String(w==null?'':w).trim(); }
function weekLabel(w){ if(!w) return '—'; const p=weekParts(w); return p?'WEEK '+p[2]+' '+MON[p[1]-1]:String(w); }
