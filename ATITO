// توحيد شكل الـ ID عشان مطابقة "1463495465" مع "1463495465.0" أو " 1463495465 " تنجح برضو
function normId(v){ return String(v==null?'':v).trim().replace(/\.0+$/,''); }
function buildQC(qpt, db, teams, empty, qpl){
  const q=cmap(qpt.headers), iId=ci(q,['actual id']), iEm=ci(q,['actual email']), iExp=ci(q,['expected date']),
        iArt=ci(q,['artifacts']), iAttr=ci(q,['attribute']), iAcc=ci(q,['total accuracy']);
  const d=cmap(db.headers), iT=ci(d,['task id']), iQ=ci(d,['qtc name']), iTs=ci(d,['timestamp']), iU=ci(d,['unit']), iL=ci(d,['labeler name']), iP=ci(d,['pass']), iLk=ci(d,['task link']);
  const byTask={};
  db.rows.forEach(r=>{
    const id=normId(gc(r,iT)); if(!id) return;
    const isQA=/QA|QUALITY/i.test(String(gc(r,iP)||''));
    if(!byTask[id]||isQA) byTask[id]={ qtc:String(gc(r,iQ)||'').trim(), ts:gc(r,iTs), unit:gc(r,iU), labeler:String(gc(r,iL)||'').trim(), link:String(gc(r,iLk)||'').trim() };
  });
  const owners=loadOwners(teams,empty); let minExp='';
  const rows=[];
  qpt.rows.forEach(r=>{
    const id=normId(gc(r,iId)); if(!id) return;
    const ex=String(gc(r,iExp)||'').substring(0,10); if(ex&&(!minExp||ex<minExp)) minExp=ex;
    const base={ taskId:id, tasks:1, artifacts:toNum(gc(r,iArt)), attribute:toNum(gc(r,iAttr)), totalAccuracy:toNum(gc(r,iAcc)) };
    const t=byTask[id];
    if(t){
      const s=shiftOf(t.unit,parseTS(t.ts));
      rows.push({...base, qtc:cleanName(t.qtc)||'—', shiftN:s?s.shift:(normShift(shiftFromName(t.qtc))||'—'), labeler:t.labeler, link:t.link, source:'Data Base'});
    } else {
      const em=String(gc(r,iEm)||''), m=em.match(/\d{6}/), o=m&&owners[m[0]];
      if(o) rows.push({...base, qtc:cleanName(o.qtc)||'—', shiftN:o.shift||'—', labeler:em, source:'Teams'});
      else rows.push({...base, qtc:'—', shiftN:'—', labeler:em, source:'Unmatched'});
    }
  });
  return { rows, weekTag:qplWeek(qpl)||weekKey(minExp), stats:{ qpt:qpt.rows.length, noId:qpt.rows.length-rows.length,
    db:rows.filter(r=>r.source==='Data Base').length, teams:rows.filter(r=>r.source==='Teams').length, un:rows.filter(r=>r.source==='Unmatched').length } };
}
