  document.getElementById('teamsResults').innerHTML=hint+`
    <div class="panel"><div class="panel-head"><h3>🔖 Team Daily Submission — ${esc(sub)}</h3></div><div class="panel-body"><div class="table-wrap shot"><table><thead><tr><th>QC</th><th>Team Daily Submission</th><th>Submitted by QTC</th><th>Submitted by External QTC</th><th>External QTCs Names</th></tr></thead>
    <tbody>${T.map(r=>`<tr class="${r.kind==='special'?'special':''}"><td>${esc(r.qtc)}</td><td><b>${r.total}</b></td><td>${r.own}</td><td>${r.ext}</td><td class="wrap">${esc(r.names)}</td></tr>`).join('')||'<tr><td colspan="5">No data</td></tr>'}
