  const w=document.createElement('div'); w.className='welcome';
  w.textContent='👋 مرحباً '+u.name+(u.position?' — '+u.position:'');
  document.body.appendChild(w); setTimeout(()=>w.remove(),4600);
}
function tryEmail(email){
  gateMsg('Checking…'); CURRENT_EMAIL=email; initData();
  const g=document.getElementById('gate'); g.classList.add('busy');
  callApi('checkemail',{email}).then(u=>{ g.classList.remove('busy'); if(u&&u.ok) bootApp(u); else gateMsg('🔒 '+((u&&u.msg)||'Access denied')); }).catch(e=>{ g.classList.remove('busy'); gateMsg('⚠️ '+e.message); });
}
function submitGateEmail(){ const e=document.getElementById('gateEmail').value.trim().toLowerCase(); if(!e){ gateMsg('⚠️ Please enter an email'); return; } tryEmail(e); }
document.getElementById('gateEmail').addEventListener('keydown',e=>{ if(e.key==='Enter') submitGateEmail(); });
let whoSeq=0;
const lookupWho=debounce(()=>{
  const em=document.getElementById('gateEmail').value.trim().toLowerCase(), box=document.getElementById('gateWho'), my=++whoSeq;
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em)){ box.innerHTML=''; return; }
  callApi('checkemail',{email:em}).then(u=>{ if(my!==whoSeq) return;
    box.innerHTML=(u&&u.ok)?'<div class="who">👤 '+esc(u.name)+(u.position?' — <span>'+esc(u.position)+'</span>':'')+'</div>':''; }).catch(()=>{ if(my===whoSeq) box.innerHTML=''; });
},500);
document.getElementById('gateEmail').addEventListener('input',()=>{ document.getElementById('gateWho').innerHTML=''; lookupWho(); });
if(API_URL.indexOf('PASTE_YOUR')===0) gateMsg('⚠️ Developer: set API_URL at the top of the script first.');
else if(CURRENT_EMAIL){
  initData();
  let cu=null; try{ cu=JSON.parse(localStorage.getItem('meeg_user')||'null'); }catch(e){}
  if(cu&&cu.ok&&cu.email===CURRENT_EMAIL){
    bootApp(cu);   // يفتح فوراً من الكاش، والفحص بيتم في الخلفية
    callApi('checkemail',{email:CURRENT_EMAIL}).then(u=>{
      if(!(u&&u.ok)){ try{localStorage.removeItem('meeg_user');}catch(e){} document.getElementById('gate').classList.remove('hide'); gateMsg('🔒 '+((u&&u.msg)||'Access denied')); }
    }).catch(()=>{});
  } else { document.getElementById('gateEmail').value=CURRENT_EMAIL; tryEmail(CURRENT_EMAIL); }
}
</script>
