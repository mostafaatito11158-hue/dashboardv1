function buildLive(db){
  const H=db.headers.map(h=>String(h).replace(/\s+/g,' ').trim()), hl=H.map(h=>h.toLowerCase());
  const shiftI=hl.indexOf('shift'); let tsIdx=hl.indexOf('timestamp'); if(tsIdx<0) tsIdx=hl.findIndex(h=>h.includes('date'));
  let loc=hl.indexOf('unit'); if(loc<0) loc=hl.indexOf('location');
  const rows=[];
  db.rows.forEach(r=>{
    if(r.every(c=>c===''||c==null)) return;
    if(shiftI>=0 && !ALL_SHIFTS.includes(String(r[shiftI]||'').trim().toLowerCase())) return;
    const row=r.slice(0,H.length), t=parseTS(row[tsIdx]);
    if(t) row[tsIdx]=t.str;
    const s=t&&shiftOf(loc>=0?row[loc]:'',t);
    row.sh=s?s.shift:normShift(shiftI>=0?row[shiftI]:'');
    rows.push(row);
  });
  const names=["Shift","Unit","Qtc Name","Yubikey Email","Labeler Name","Pc No","Modality","Queue Name","Pass"];
  const si={}, so={};
  names.forEach(n=>{ const i=hl.indexOf(n.toLowerCase()); if(i>=0){ si[n]=i; so[n]=[...new Set(rows.map(r=>String(r[i]||'').trim()).filter(Boolean))].sort(); } });
  so['Shift']=['M','N','ON'];
  so['_dates']=[...new Set(rows.map(r=>tsIdx>=0?String(r[tsIdx]||'').substring(0,10):'').filter(x=>/^\d{4}-/.test(x)))].sort().reverse();
  const locations=loc>=0?[...new Set(rows.map(r=>String(r[loc]||'').trim()).filter(Boolean))].sort():[];
  return { headers:H.map(h=>h||'—'), rows, slicerIndices:si, slicerOptions:so, tsIdx, locationColIdx:loc, locations, linkIdx:hl.indexOf('task link'), idIdx:hl.indexOf('task id') };
}
