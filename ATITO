function fmtDT(d){ return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+' '+pad(d.getHours())+':'+pad(d.getMinutes())+':'+pad(d.getSeconds()); }
const isQAPass=p=>/QA|QUALITY|QQ|SPOT/.test(String(p||'').toUpperCase());
function auditFast(db,from,to){
  const c=cmap(db.headers), I={ts:ci(c,['timestamp']),unit:ci(c,['unit']),qc:ci(c,['qtc name']),lab:ci(c,['labeler name']),mod:ci(c,['modality']),q:ci(c,['queue name']),
    pass:ci(c,['pass']),pc:ci(c,['pc no']),obj:ci(c,['object count','objects count','objects']),tid:ci(c,['task id']),link:ci(c,['task link'])};
  if(I.qc<0) throw new Error('Column "QTC Name" not found in Data Base. Columns: '+db.headers.join(' | '));
  const G={labelerLane:{},labelerLidar:{},qcLane:{},qcLidar:{}};
  db.rows.forEach((r,i)=>{
    if(db.orange&&db.orange[i]) return;
    const pass=String(gc(r,I.pass)||'').toUpperCase(), qa=isQAPass(pass);
    if(fastF.pass==='QA'&&!qa) return; if(fastF.pass==='FP'&&qa) return;
    const t=parseTS(gc(r,I.ts)); if(!t||t.ms<from||t.ms>to) return;
    const sh=shiftOf(gc(r,I.unit),t).shift; if(fastF.shift&&sh!==fastF.shift) return;
    const lane=/LANE|2D|LINE/i.test(String(gc(r,I.mod)||''));
    if(fastF.mod==='lane'&&!lane) return; if(fastF.mod==='lidar'&&lane) return;
    const lab=String(gc(r,I.lab)||'').trim(), qc=String(gc(r,I.qc)||'').trim();
    const it={ ms:t.ms, shift:sh, unit:String(gc(r,I.unit)||'').trim(), queue:String(gc(r,I.q)||'').trim()||'Default Queue', key:String(gc(r,I.tid)||gc(r,I.link)||'').trim(),
      taskId:String(gc(r,I.tid)||'').trim(), link:String(gc(r,I.link)||'').trim(), pc:String(gc(r,I.pc)||'').trim(), obj:gc(r,I.obj), labeler:lab, qc, pass };
    const add=(key,name)=>{ if(!name) return; const m=G[key]; ((m[name]=m[name]||{})[it.queue]=m[name][it.queue]||[]).push(it); };
    if(fastF.role!=='qc') add(lane?'labelerLane':'labelerLidar',lab);
    if(fastF.role!=='labeler') add(lane?'qcLane':'qcLidar',qc);
  });
  return { labelerLane:auditGroups(G.labelerLane,10), labelerLidar:auditGroups(G.labelerLidar,10), qcLane:auditGroups(G.qcLane,5), qcLidar:auditGroups(G.qcLidar,5) };
}
function auditGroups(grouped,thr){
  const out=[];
  Object.keys(grouped).sort().forEach(name=>Object.keys(grouped[name]).forEach(queue=>{
    const t=grouped[name][queue].slice().sort((a,b)=>a.ms-b.ms), fl=[];
    for(let i=1;i<t.length;i++){
      const p=t[i-1], c=t[i], diff=(c.ms-p.ms)/60000;
      if(diff<thr){ if(!fl.length||fl[fl.length-1].key!==p.key) fl.push({...p,timeFormatted:fmtDT(new Date(p.ms)),diff:'Base Task'}); fl.push({...c,timeFormatted:fmtDT(new Date(c.ms)),diff:diff.toFixed(1)+' mins'}); }
    }
    if(fl.length) out.push({name,queueName:queue,count:fl.length,rows:fl});
  }));
  return out;
}
